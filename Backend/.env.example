###############################################################################
# HarSimuVerse — API (Laravel 12)
#
# Desarrollo con Docker: NO hace falta tocar este archivo. El entrypoint copia
# .env.example a .env y genera APP_KEY, y docker-compose sobreescribe la
# conexion a la base (las variables del contenedor ganan sobre .env).
#
# Desarrollo sin Docker: cp .env.example .env && php artisan key:generate
###############################################################################

APP_NAME=HarSimuVerse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---- Logs ----
# En contenedores conviene `stderr`: los logs los recoge Docker/Render.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de datos ----
# sqlite = fallback local sin servicios extra.
# pgsql  = lo que usan docker-compose y Render (los puntajes sobreviven deploys).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=harsimuverse
# DB_USERNAME=harsimuverse
# DB_PASSWORD=secret
#
# Render entrega la conexion como una sola URL. El entrypoint mapea
# DATABASE_URL -> DB_URL automaticamente, pero se puede fijar a mano:
# DB_URL=postgres://usuario:clave@host:5432/basededatos

# ---- CORS ----
# Origenes del frontend autorizados a llamar la API, separados por comas.
# Sin esto el navegador bloquea las peticiones desde Vercel.
# En produccion:  CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=http://localhost:4200
# Regex opcional para los dominios de preview de Vercel:
# CORS_ALLOWED_ORIGIN_PATTERN=#^https://harsimuverse-.*\.vercel\.app$#

# ---- Sesiones, cache y colas ----
# La API no usa sesiones; `file` evita depender de la base para esto.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---- Canal en vivo del estado del servicio (Laravel Reverb) ----
# REVERB_APP_KEY es PUBLICA: viaja al navegador para suscribirse al canal.
# REVERB_APP_SECRET no sale del servidor; firma los eventos que se emiten.
REVERB_APP_ID=harsimuverse
REVERB_APP_KEY=harsimuverse-status
REVERB_APP_SECRET=cambia-esto-en-produccion

# Donde encuentra el BACKEND al servidor Reverb para emitirle los eventos.
# En docker-compose es el nombre del servicio; suelto en local, 127.0.0.1.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Donde ESCUCHA el propio servidor Reverb.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Origenes que pueden abrir el socket. '*' en desarrollo; en produccion, el
# dominio real del front (mismo criterio que CORS_ALLOWED_ORIGINS).
REVERB_ALLOWED_ORIGINS=*

# ---- Migraciones automaticas al arrancar el contenedor ----
RUN_MIGRATIONS=true

# ---- Correo (no se usa en este proyecto) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
