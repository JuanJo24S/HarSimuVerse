# Plantilla de nginx: ${PORT} lo resuelve envsubst en el entrypoint,
# porque Render asigna el puerto en tiempo de ejecucion.
user www-data;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    server_tokens off;

    client_max_body_size 20M;

    # Necesario para proxiar WebSocket: `Connection` tiene que ser "upgrade"
    # solo cuando el cliente lo pide, y "close" en el resto de peticiones.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml+rss text/xml;

    server {
        listen ${PORT} default_server;
        server_name _;

        root /var/www/html/public;
        index index.php;

        charset utf-8;

        # Render/proxies terminan TLS por fuera: respetamos el esquema original.
        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        # /up es el healthcheck de Laravel; no queremos ruido en los logs.
        location = /up {
            access_log off;
            try_files $uri /index.php?$query_string;
        }

        #
        # Canal en vivo del estado -> servidor Reverb.
        #
        # Va detras de este mismo nginx y no en un puerto propio porque Render
        # publica UN solo puerto por servicio. Reverb escucha en el 8080 interno
        # y aqui se expone como /ws, asi que el front usa el mismo dominio (y el
        # mismo certificado) que la API.
        #
        # La barra final del proxy_pass es la que quita el prefijo /ws: el
        # cliente pide /ws/app/<key> y a Reverb le llega /app/<key>, que es la
        # ruta que entiende el protocolo Pusher.
        #
        location /ws/ {
            proxy_pass http://127.0.0.1:${REVERB_SERVER_PORT}/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # El socket esta callado entre latidos (25s). Sin subir estos
            # timeouts, nginx cortaria la conexion cada 60s por inactividad y el
            # cliente reconectaria en bucle sin motivo.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            # Un buffer intermedio retrasaria el latido: se entrega en cuanto llega.
            proxy_buffering off;

            access_log off;
        }

        error_page 404 /index.php;

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTPS $http_x_forwarded_proto;
            fastcgi_hide_header X-Powered-By;
            fastcgi_read_timeout 60;
        }

        # Nunca servir archivos ocultos ni fuentes .php sueltas fuera de public.
        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
