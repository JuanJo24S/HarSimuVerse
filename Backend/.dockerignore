# Se instalan dentro de la imagen, nunca se copian del host.
vendor/
node_modules/

# Secretos y bases locales.
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
database/database.sqlite

# Cache y logs que no deben viajar a la imagen.
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/

# Build del frontend embebido de Laravel (no se usa, el front es Angular).
public/build/
public/hot
public/storage

# Metadatos de git y editores.
.git/
.github/
.gitignore
.gitattributes
.idea/
.vscode/
.fleet/

# El propio Dockerfile y compose no hacen falta dentro de la imagen.
Dockerfile
.dockerignore
