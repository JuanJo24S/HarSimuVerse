###############################################################################
# Variables para `docker compose`. Copiar a `.env` y ajustar si hace falta:
#   cp .env.example .env
# Todos los valores tienen default en docker-compose.yml, asi que el archivo
# .env es opcional: sirve para cambiar puertos si ya tienes algo ocupandolos.
###############################################################################

# ---- Puertos publicados en el host ----
# El juego no usa servidor: los puntajes viven en localStorage del navegador.
# Solo FRONTEND_PORT aplica a `docker compose up`. El resto son para los
# servicios que quedan tras el perfil `backend`, por si se retoman:
#   docker compose --profile backend up
FRONTEND_PORT=4300
BACKEND_PORT=8000
DB_PORT=5433
REVERB_PORT=8081

# ---- Base de datos (solo con --profile backend) ----
DB_DATABASE=harsimuverse
DB_USERNAME=harsimuverse
DB_PASSWORD=secret

# ---- Canal en vivo del estado (solo con --profile backend) ----
# La KEY es publica: viaja al navegador para suscribirse al canal.
# El SECRET no sale del servidor. Cambialo en produccion.
REVERB_APP_ID=harsimuverse
REVERB_APP_KEY=harsimuverse-status
REVERB_APP_SECRET=secreto-de-desarrollo

# ---- Laravel ----
# APP_KEY no se configura aqui: el entrypoint del backend la genera y la
# persiste en Backend/.env la primera vez que arranca el contenedor.
# Se define a mano solo en produccion (panel de Render).
